{#- Design tokens: `theme` = accent colour, `style` = overall look (background / text / card material). Both are
    validated in render_deck_html() before rendering, so they are always members of the supported sets. -#}
{% set theme = deck.theme_color | default('sky') %}
{% set style = design_style | default(deck.design_style, true) | default('immersive-dark', true) %}
{% set ui_format = ui_format | default(deck.ui_format, true) | default('portal', true) %}
{% set is_light = style in ['clean-light', 'editorial-light'] %}
{% set grad_to_map = {'sky': 'indigo', 'emerald': 'teal', 'violet': 'fuchsia', 'amber': 'orange', 'rose': 'pink'} %}
{% set grad_hue = grad_to_map.get(theme, 'indigo') %}
{% if is_light %}
  {% set accent_text = 'text-' ~ theme ~ '-600' %}
  {% set accent_text_light = 'text-' ~ theme ~ '-700' %}
  {% set accent_bg = 'bg-' ~ theme ~ '-600' %}
  {% set accent_bg_hover = 'hover:bg-' ~ theme ~ '-700' %}
  {% set accent_bg_soft = 'bg-' ~ theme ~ '-50' %}
  {% set accent_border = 'border-' ~ theme ~ '-500' %}
  {% set accent_border_soft = 'border-' ~ theme ~ '-200' %}
  {% set grad_from = 'from-' ~ theme ~ '-500' %}
  {% set grad_to = 'to-' ~ grad_hue ~ '-600' %}
  {% set btn_primary_text = 'text-white' %}
{% else %}
  {% set accent_text = 'text-' ~ theme ~ '-400' %}
  {% set accent_text_light = 'text-' ~ theme ~ '-300' %}
  {% set accent_bg = 'bg-' ~ theme ~ '-500' %}
  {% set accent_bg_hover = 'hover:bg-' ~ theme ~ '-400' %}
  {% set accent_bg_soft = 'bg-' ~ theme ~ '-500/10' %}
  {% set accent_border = 'border-' ~ theme ~ '-400' %}
  {% set accent_border_soft = 'border-' ~ theme ~ '-400/30' %}
  {% set grad_from = 'from-' ~ theme ~ '-400' %}
  {% set grad_to = 'to-' ~ grad_hue ~ '-600' %}
  {% set btn_primary_text = 'text-slate-950' %}
{% endif %}
{% if style == 'clean-light' %}
  {% set t_heading = 'text-slate-900' %}
  {% set t_body = 'text-slate-600' %}
  {% set t_body_strong = 'text-slate-800' %}
  {% set t_body_soft = 'text-slate-700' %}
  {% set t_muted = 'text-slate-500' %}
  {% set rule = 'border-slate-200' %}
  {% set rule_soft = 'border-slate-200' %}
  {% set rule_card = 'border-slate-200' %}
  {% set chip = 'bg-slate-50 border border-slate-200 text-slate-700' %}
  {% set step_card = 'bg-slate-50 border border-slate-200' %}
  {% set roi_card = 'bg-emerald-50 border border-emerald-200' %}
  {% set good = 'text-emerald-600' %}
  {% set bad = 'text-rose-500' %}
  {% set star = 'text-amber-500' %}
  {% set milestone = 'text-emerald-700' %}
  {% set challenge_label = 'text-rose-600' %}
  {% set challenge_border = 'border-t-rose-500' %}
  {% set footer_bar = 'bg-white/90 backdrop-blur-md border-t border-slate-200' %}
  {% set track = 'bg-slate-200' %}
  {% set btn_secondary = 'bg-slate-100 hover:bg-slate-200 text-slate-700' %}
{% elif style == 'editorial-light' %}
  {% set t_heading = 'text-stone-900' %}
  {% set t_body = 'text-stone-600' %}
  {% set t_body_strong = 'text-stone-800' %}
  {% set t_body_soft = 'text-stone-700' %}
  {% set t_muted = 'text-stone-500' %}
  {% set rule = 'border-stone-300' %}
  {% set rule_soft = 'border-stone-200' %}
  {% set rule_card = 'border-stone-300' %}
  {% set chip = 'bg-stone-100 border border-stone-200 text-stone-700' %}
  {% set step_card = 'bg-white border border-stone-200' %}
  {% set roi_card = 'bg-emerald-50 border border-emerald-200' %}
  {% set good = 'text-emerald-700' %}
  {% set bad = 'text-rose-600' %}
  {% set star = 'text-amber-600' %}
  {% set milestone = 'text-emerald-800' %}
  {% set challenge_label = 'text-rose-700' %}
  {% set challenge_border = 'border-t-rose-600' %}
  {% set footer_bar = 'bg-stone-50/95 border-t border-stone-300' %}
  {% set track = 'bg-stone-200' %}
  {% set btn_secondary = 'bg-stone-200 hover:bg-stone-300 text-stone-800' %}
{% else %}
  {% set t_heading = 'text-white' %}
  {% set t_body = 'text-slate-300' %}
  {% set t_body_strong = 'text-slate-100' %}
  {% set t_body_soft = 'text-slate-200' %}
  {% set t_muted = 'text-slate-400' %}
  {% set rule = 'border-slate-800' %}
  {% set rule_soft = 'border-slate-800/80' %}
  {% set rule_card = 'border-slate-700/80' %}
  {% set chip = 'bg-slate-800/90 border border-slate-700 text-slate-200' %}
  {% set step_card = 'bg-slate-800/80 border border-slate-700' %}
  {% set roi_card = 'bg-emerald-950/30 border border-emerald-500/30' %}
  {% set good = 'text-emerald-400' %}
  {% set bad = 'text-rose-400' %}
  {% set star = 'text-amber-400' %}
  {% set milestone = 'text-emerald-300' %}
  {% set challenge_label = 'text-rose-400' %}
  {% set challenge_border = 'border-t-rose-500/80' %}
  {% set footer_bar = 'bg-slate-950/80 backdrop-blur-md border-t border-slate-800/80' %}
  {% set track = 'bg-slate-800' %}
  {% set btn_secondary = 'bg-slate-800 hover:bg-slate-700 text-slate-200' %}
{% endif %}
<!DOCTYPE html>
<html lang="ja" data-ui-format="{{ ui_format }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{{ deck.client_name }} 御中 - {{ deck.proposal_title }} | {{ brand_name | default('Strategic AI Partners') }}</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- GSAP 3.12.2 -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <!-- FontAwesome 6.4.0 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Noto+Sans+JP:wght@400;500;700;900&family=Plus+Jakarta+Sans:wght@500;700;800{% if style == 'editorial-light' %}&family=Noto+Serif+JP:wght@500;700;900{% endif %}&display=swap" rel="stylesheet" />
  <style>
    :root {
      --font-sans: 'Plus Jakarta Sans', 'Noto Sans JP', sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
      --font-serif: 'Noto Serif JP', serif;
    }
    body {
      font-family: var(--font-sans);
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      background-color: #0b0f19;
      color: #f8fafc;
      margin: 0;
      padding: 0;
      user-select: none;
    }
    body[data-style="clean-light"] {
      background-color: #ffffff;
      color: #0f172a;
    }
    body[data-style="editorial-light"] {
      background-color: #faf7f2;
      color: #1c1917;
    }
    .font-mono-code {
      font-family: var(--font-mono);
    }
    .slide {
      position: absolute;
      inset: 0;
      width: 100vw;
      height: 100vh;
      display: none;
      flex-direction: column;
      justify-content: space-between;
      padding: 3.5rem 5rem 5.5rem 5rem;
      box-sizing: border-box;
    }
    .slide.active {
      display: flex;
    }
    .glass-card {
      background: rgba(15, 23, 42, 0.78);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(148, 163, 184, 0.16);
      box-shadow: 0 20px 50px rgba(2, 6, 23, 0.5);
    }
    body[data-style="clean-light"] .glass-card {
      background: #ffffff;
      backdrop-filter: none;
      border: 1px solid #e2e8f0;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04), 0 12px 32px rgba(15, 23, 42, 0.08);
    }
    body[data-style="editorial-light"] .glass-card {
      background: #fffdf9;
      backdrop-filter: none;
      border: 1px solid #e7e0d6;
      box-shadow: none;
      border-radius: 6px !important;
    }
    body[data-style="editorial-light"] h1,
    body[data-style="editorial-light"] h2,
    body[data-style="editorial-light"] h3,
    body[data-style="editorial-light"] h4 {
      font-family: var(--font-serif);
      letter-spacing: 0.01em;
    }
    .bg-grid-pattern {
      background-image: radial-gradient(rgba(56, 189, 248, 0.12) 1px, transparent 1px);
      background-size: 32px 32px;
    }
    /* Portal mode layout for template decks */
    html[data-ui-format="slides"] #tpl-portal-sidebar,
    html[data-ui-format="slides"] #tpl-portal-topbar {
      display: none !important;
    }
    html[data-ui-format="portal"] body {
      overflow-x: hidden !important;
      overflow-y: auto !important;
      height: auto !important;
      min-height: 100vh !important;
      user-select: text !important;
    }
    html[data-ui-format="portal"] > body > header {
      display: none !important;
    }
    html[data-ui-format="portal"] #tpl-portal-shell {
      display: grid;
      grid-template-columns: 280px minmax(0, 1fr);
      min-height: 100vh;
      width: 100%;
    }
    @media (max-width: 1024px) {
      html[data-ui-format="portal"] #tpl-portal-shell {
        grid-template-columns: minmax(0, 1fr);
      }
      html[data-ui-format="portal"] #tpl-portal-sidebar {
        display: none !important;
      }
    }
    html[data-ui-format="portal"] #deck-container {
      max-width: 1040px;
      margin: 0 auto;
      padding: 1.5rem 2.5rem 6rem 2.5rem;
      height: auto !important;
    }
    html[data-ui-format="portal"] .slide {
      position: relative !important;
      inset: auto !important;
      width: 100% !important;
      height: auto !important;
      min-height: 68vh;
      padding: 2rem 1rem 3rem 1rem !important;
    }
    html[data-ui-format="portal"] .tpl-chapter-btn.is-active {
      border-color: rgba(56, 189, 248, 0.55);
      background: rgba(56, 189, 248, 0.12);
    }
  </style>
  {% if custom_css %}
  <!-- Deck-specific overrides (sanitized by sanitize_custom_css before rendering) -->
  <style id="deck-custom-css">{{ custom_css | safe }}</style>
  {% endif %}
</head>
<body class="{% if style == 'immersive-dark' %}bg-grid-pattern {% endif %}relative" data-theme="{{ theme }}" data-style="{{ style }}">
  {% if style == 'immersive-dark' %}
  <!-- Ambient Glows -->
  <div class="pointer-events-none fixed -top-40 -left-40 w-96 h-96 rounded-full {{ accent_bg_soft }} blur-3xl"></div>
  <div class="pointer-events-none fixed -bottom-40 -right-40 w-96 h-96 rounded-full bg-indigo-500/15 blur-3xl"></div>
  {% elif style == 'clean-light' %}
  <!-- Accent hairline -->
  <div class="pointer-events-none fixed top-0 left-0 right-0 h-1 z-40 bg-gradient-to-r {{ grad_from }} {{ grad_to }}"></div>
  {% else %}
  <!-- Editorial rule -->
  <div class="pointer-events-none fixed top-0 left-0 right-0 h-[3px] z-40 bg-stone-900"></div>
  {% endif %}

  <!-- Top Brand Header -->
  <header class="fixed top-0 left-0 right-0 z-30 flex items-center justify-between px-20 py-5 pointer-events-none">
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-gradient-to-br {{ grad_from }} {{ grad_to }} text-white font-bold text-sm shadow">{{ brand_badge | default('SP') }}</span>
      <span class="font-mono-code text-xs tracking-widest uppercase {{ t_muted }}">{{ brand_name | default('Strategic AI Partners') }} // Strategic Digital Proposal</span>
    </div>
    <div class="font-mono-code text-xs {{ t_muted }}">
      CONFIDENTIAL // FOR {{ deck.client_name }}
    </div>
  </header>

  <div id="tpl-portal-shell" class="w-full h-full">
    <aside id="tpl-portal-sidebar" class="sticky top-0 h-screen overflow-y-auto border-r {{ rule }} p-5 flex flex-col justify-between z-20">
      <div>
        <div class="flex items-center gap-2.5 mb-4 pb-3 border-b {{ rule }}">
          <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-gradient-to-br {{ grad_from }} {{ grad_to }} text-white font-bold text-xs shadow">{{ brand_badge | default('NY') }}</span>
          <div class="min-w-0">
            <div class="font-mono-code text-[10px] uppercase tracking-wider {{ accent_text }}">PROPOSAL PORTAL</div>
            <div class="text-xs font-bold truncate {{ t_heading }}">{{ deck.client_name }} 御中</div>
          </div>
        </div>
        <div class="font-mono-code text-[10px] uppercase tracking-widest {{ t_muted }} mb-2">CHAPTERS (06)</div>
        <nav class="space-y-1.5" aria-label="章ナビゲーション">
          <button type="button" data-target-slide="0" class="tpl-chapter-btn is-active w-full text-left px-3 py-2 rounded-lg border border-transparent transition flex items-baseline gap-2.5">
            <span class="font-mono-code text-xs font-bold {{ accent_text }}">01</span>
            <span class="text-xs font-semibold {{ t_body_strong }}">表紙・ご提案概要</span>
          </button>
          <button type="button" data-target-slide="1" class="tpl-chapter-btn w-full text-left px-3 py-2 rounded-lg border border-transparent transition flex items-baseline gap-2.5">
            <span class="font-mono-code text-xs font-bold {{ accent_text }}">02</span>
            <span class="text-xs font-semibold {{ t_body_strong }}">現状課題とエグゼクティブ結論</span>
          </button>
          <button type="button" data-target-slide="2" class="tpl-chapter-btn w-full text-left px-3 py-2 rounded-lg border border-transparent transition flex items-baseline gap-2.5">
            <span class="font-mono-code text-xs font-bold {{ accent_text }}">03</span>
            <span class="text-xs font-semibold {{ t_body_strong }}">As-Is / To-Be と顧客体験変革</span>
          </button>
          <button type="button" data-target-slide="3" class="tpl-chapter-btn w-full text-left px-3 py-2 rounded-lg border border-transparent transition flex items-baseline gap-2.5">
            <span class="font-mono-code text-xs font-bold {{ accent_text }}">04</span>
            <span class="text-xs font-semibold {{ t_body_strong }}">4層システム・データ連携構成</span>
          </button>
          <button type="button" data-target-slide="4" class="tpl-chapter-btn w-full text-left px-3 py-2 rounded-lg border border-transparent transition flex items-baseline gap-2.5">
            <span class="font-mono-code text-xs font-bold {{ accent_text }}">05</span>
            <span class="text-xs font-semibold {{ t_body_strong }}">導入ロードマップ（3フェーズ）</span>
          </button>
          <button type="button" data-target-slide="5" class="tpl-chapter-btn w-full text-left px-3 py-2 rounded-lg border border-transparent transition flex items-baseline gap-2.5">
            <span class="font-mono-code text-xs font-bold {{ accent_text }}">06</span>
            <span class="text-xs font-semibold {{ t_body_strong }}">期待ROIとネクストステップ</span>
          </button>
        </nav>
      </div>
      <div class="pt-4 border-t {{ rule }} text-[11px] {{ t_muted }}">
        <div>GENERATED: {{ generated_date }}</div>
      </div>
    </aside>
    <div class="min-w-0 flex-1 flex flex-col">
      <div id="tpl-portal-topbar" class="sticky top-0 z-20 px-8 py-3 border-b {{ rule }} flex items-center justify-between gap-4">
        <div class="text-xs {{ t_muted }} truncate">
          <span class="font-mono-code uppercase {{ accent_text }}">CONFIDENTIAL</span>
          <span class="mx-2">/</span>
          <strong class="{{ t_heading }}">{{ deck.proposal_title }}</strong>
        </div>
        <button id="tpl-slide-view-btn" type="button" class="px-3 py-1.5 rounded-lg {{ btn_secondary }} text-xs font-mono-code transition flex items-center gap-1.5 shrink-0">
          <i class="fa-solid fa-display"></i> スライドで見る
        </button>
      </div>
      <main id="deck-container" class="relative w-full h-full" data-ui-format="{{ ui_format }}">
    <!-- Slide 01: Hero Cover -->
    <section class="slide active" data-slide-index="0" data-layout="hero-cover">
      <div class="my-auto max-w-5xl">
        <div class="anim-item inline-flex items-center gap-2 px-4 py-1.5 rounded-full {{ accent_bg_soft }} border {{ accent_border_soft }} {{ accent_text_light }} text-xs font-mono-code mb-6">
          <i class="fa-solid fa-compass"></i>
          <span>BESPOKE EXECUTIVE PROPOSAL // THEME: {{ theme | upper }} // STYLE: {{ style | upper }}</span>
        </div>
        <h2 class="anim-item text-2xl md:text-3xl font-bold {{ accent_text }} mb-3 tracking-wide">
          {{ deck.client_name }} 御中
        </h2>
        <h1 class="anim-item text-4xl md:text-6xl font-black tracking-tight leading-tight {{ t_heading }} mb-6">
          {{ deck.proposal_title }}
        </h1>
        <p class="anim-item text-lg md:text-xl {{ t_body }} leading-relaxed max-w-3xl border-l-4 {{ accent_border }} pl-5 py-1">
          {{ deck.subtitle }}
        </p>
        {% if deck.custom_callout %}
        <div class="anim-item mt-6 inline-flex items-center gap-3 px-4 py-2.5 rounded-xl glass-card border {{ accent_border_soft }} text-xs {{ t_body_soft }}">
          <i class="fa-solid fa-sparkles {{ accent_text }}"></i>
          <span>{{ deck.custom_callout }}</span>
        </div>
        {% endif %}
      </div>
      <div class="anim-item flex items-center justify-between border-t {{ rule }} pt-4 text-xs {{ t_muted }} font-mono-code">
        <span>PREPARED BY: {{ (brand_name | default('STRATEGIC AI PARTNERS')) | upper }}</span>
        <span>GENERATED AT: {{ generated_date }}</span>
      </div>
    </section>

    <!-- Slide 02: Asymmetric Bento Executive Summary -->
    <section class="slide" data-slide-index="1" data-layout="bento-executive-summary">
      <div class="mt-8">
        <div class="anim-item flex items-center gap-2 {{ accent_text }} font-mono-code text-xs uppercase tracking-widest mb-1">
          <span>02 // Executive Summary &amp; Diagnostic Bento</span>
        </div>
        <h2 class="anim-item text-3xl font-bold {{ t_heading }}">現状の課題認識と本提案の結論</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-auto">
        {% for item in deck.current_challenges %}
        <div class="anim-item glass-card rounded-2xl p-6 border-t-4 {{ challenge_border }} flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono-code text-xs {{ challenge_label }} uppercase tracking-wider">Challenge 0{{ loop.index }}</span>
              <i class="fa-solid fa-triangle-exclamation {{ challenge_label }} text-lg"></i>
            </div>
            <h3 class="text-lg font-bold {{ t_heading }} mb-2">{{ item.title }}</h3>
            <p class="text-sm {{ t_body }} leading-relaxed">{{ item.description }}</p>
          </div>
          <div class="mt-4 pt-3 border-t {{ rule_soft }} flex items-center justify-between text-[11px] font-mono-code {{ t_muted }}">
            <span>PRIORITY: HIGH</span>
            <span class="{{ accent_text }}">TARGET FOR AI TRANSFORMATION</span>
          </div>
        </div>
        {% endfor %}
      </div>

      <div class="anim-item glass-card rounded-2xl p-6 border-l-4 {{ accent_border }} bg-gradient-to-r {{ accent_bg_soft }} to-transparent">
        <div class="flex items-center gap-3 mb-2">
          <i class="fa-solid fa-lightbulb {{ accent_text }} text-xl"></i>
          <span class="font-mono-code text-xs uppercase tracking-wider {{ accent_text_light }}">Strategic Conclusion // 変革の結論</span>
        </div>
        <p class="text-base md:text-lg font-semibold {{ t_heading }} leading-relaxed">
          {{ deck.executive_conclusion }}
        </p>
      </div>
    </section>

    <!-- Slide 03: Split As-Is / To-Be Comparison Matrix & CX Highlights -->
    <section class="slide" data-slide-index="2" data-layout="as-is-to-be-comparison">
      <div class="mt-8">
        <div class="anim-item flex items-center gap-2 {{ accent_text }} font-mono-code text-xs uppercase tracking-widest mb-1">
          <span>03 // Solution Approach &amp; CX Transformation</span>
        </div>
        <h2 class="anim-item text-3xl font-bold {{ t_heading }}">解決アプローチと顧客体験（UX / AI）の変革</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-auto">
        <div class="anim-item glass-card rounded-2xl p-6 border {{ rule_card }}">
          <div class="flex items-center gap-2 {{ t_muted }} font-mono-code text-xs uppercase mb-3">
            <i class="fa-solid fa-clock-rotate-left"></i>
            <span>AS-IS (Before) // 従来の業務・体験</span>
          </div>
          <ul class="space-y-3 text-sm {{ t_body }}">
            {% for b in deck.before_state %}
            <li class="flex items-start gap-3">
              <i class="fa-solid fa-xmark {{ bad }} mt-1"></i>
              <span>{{ b }}</span>
            </li>
            {% endfor %}
          </ul>
        </div>

        <div class="anim-item glass-card rounded-2xl p-6 border {{ accent_border_soft }} {{ accent_bg_soft }}">
          <div class="flex items-center gap-2 {{ accent_text_light }} font-mono-code text-xs uppercase mb-3">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            <span>TO-BE (After) // AI・デジタル変革後の体験</span>
          </div>
          <ul class="space-y-3 text-sm {{ t_body_strong }}">
            {% for a in deck.after_state %}
            <li class="flex items-start gap-3">
              <i class="fa-solid fa-circle-check {{ good }} mt-1"></i>
              <span>{{ a }}</span>
            </li>
            {% endfor %}
          </ul>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {% for cx in deck.cx_highlights %}
        <div class="anim-item glass-card rounded-xl p-4 flex items-start gap-3">
          <div class="w-9 h-9 rounded-lg {{ accent_bg_soft }} border {{ accent_border_soft }} flex items-center justify-center {{ accent_text_light }} shrink-0">
            <i class="fa-solid fa-bolt"></i>
          </div>
          <div>
            <h4 class="text-sm font-bold {{ t_heading }}">{{ cx.title }}</h4>
            <p class="text-xs {{ t_body }} mt-1 leading-relaxed">{{ cx.detail }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    </section>

    <!-- Slide 04: 4-Layer Architecture Flow with SVG Connectors -->
    <section class="slide" data-slide-index="3" data-layout="architecture-flow">
      <div class="mt-8">
        <div class="anim-item flex items-center gap-2 {{ accent_text }} font-mono-code text-xs uppercase tracking-widest mb-1">
          <span>04 // System &amp; Data Integration Architecture</span>
        </div>
        <h2 class="anim-item text-3xl font-bold {{ t_heading }}">システム・データ連携アーキテクチャ（4層構成）</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-5 my-auto relative">
        {% for node in deck.architecture_nodes %}
        <div class="anim-item glass-card rounded-2xl p-5 flex flex-col justify-between relative border-t-4 {{ accent_border }}">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="font-mono-code text-xs {{ accent_text }}">LAYER 0{{ loop.index }}</span>
              <i class="fa-solid {{ node.icon or 'fa-layer-group' }} {{ accent_text_light }} text-lg"></i>
            </div>
            <h3 class="text-base font-bold {{ t_heading }} mb-3">{{ node.layer_name }}</h3>
            <div class="space-y-2 mb-4">
              {% for comp in node.components %}
              <div class="px-3 py-1.5 rounded-lg {{ chip }} text-xs font-medium flex items-center gap-2">
                <i class="fa-solid fa-cube {{ accent_text }} text-[10px]"></i>
                <span>{{ comp }}</span>
              </div>
              {% endfor %}
            </div>
          </div>
          <p class="text-xs {{ t_muted }} leading-relaxed border-t {{ rule }} pt-3">
            {{ node.description }}
          </p>
        </div>
        {% endfor %}
      </div>

      <div class="anim-item text-xs {{ t_muted }} font-mono-code flex items-center justify-between">
        <span><i class="fa-solid fa-shield-halved {{ good }} mr-2"></i>ZERO-TRUST ACCESS &amp; ENTERPRISE GOVERNANCE ENABLED</span>
        <span class="flex items-center gap-2">
          <span>DATA &amp; INFERENCE PIPELINE</span>
          <svg class="w-16 h-3 {{ accent_text }}" viewBox="0 0 64 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 6H58M58 6L52 1M58 6L52 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </div>
    </section>

    <!-- Slide 05: 3-Phase Implementation Roadmap Timeline -->
    <section class="slide" data-slide-index="4" data-layout="roadmap-timeline">
      <div class="mt-8">
        <div class="anim-item flex items-center gap-2 {{ accent_text }} font-mono-code text-xs uppercase tracking-widest mb-1">
          <span>05 // Implementation Roadmap</span>
        </div>
        <h2 class="anim-item text-3xl font-bold {{ t_heading }}">導入ロードマップ（Phase 1 〜 Phase 3）</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-auto">
        {% for phase in deck.roadmap_phases %}
        <div class="anim-item glass-card rounded-2xl p-6 flex flex-col justify-between border-l-4 {{ accent_border }}">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="font-mono-code text-xs px-2.5 py-1 rounded {{ accent_bg_soft }} {{ accent_text_light }} font-semibold">{{ phase.period }}</span>
              <span class="font-mono-code text-xs {{ t_muted }}">PHASE 0{{ loop.index }}</span>
            </div>
            <h3 class="text-lg font-bold {{ t_heading }} mb-4">{{ phase.phase_name }}</h3>
            <ul class="space-y-2.5 text-sm {{ t_body }} mb-4">
              {% for d in phase.deliverables %}
              <li class="flex items-start gap-2.5">
                <i class="fa-solid fa-check {{ accent_text }} mt-1 text-xs"></i>
                <span>{{ d }}</span>
              </li>
              {% endfor %}
            </ul>
          </div>
          <div class="pt-3 border-t {{ rule }} text-xs {{ milestone }} font-mono-code flex items-center gap-2">
            <i class="fa-solid fa-flag-checkered"></i>
            <span>Milestone: {{ phase.milestone }}</span>
          </div>
        </div>
        {% endfor %}
      </div>

      <div class="anim-item text-xs {{ t_muted }} font-mono-code">
        <i class="fa-solid fa-circle-info {{ accent_text }} mr-2"></i>アジャイルスプリント方式により、初期プロトタイプを最短2週間で立ち上げ、段階的に本番展開します。
      </div>
    </section>

    <!-- Slide 06: Expected ROI & Immediate Next Steps Matrix -->
    <section class="slide" data-slide-index="5" data-layout="roi-and-next-steps">
      <div class="mt-8">
        <div class="anim-item flex items-center gap-2 {{ accent_text }} font-mono-code text-xs uppercase tracking-widest mb-1">
          <span>06 // Expected ROI &amp; Next Steps</span>
        </div>
        <h2 class="anim-item text-3xl font-bold {{ t_heading }}">期待効果（ROI）とネクストステップ</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-auto">
        <div class="anim-item glass-card rounded-2xl p-6">
          <div class="flex items-center gap-2 {{ good }} font-mono-code text-xs uppercase mb-4">
            <i class="fa-solid fa-chart-line"></i>
            <span>Quantitative &amp; Qualitative Impact // 期待効果</span>
          </div>
          <div class="space-y-3 mb-4">
            {% for q in deck.quantitative_roi %}
            <div class="p-3 rounded-xl {{ roi_card }} flex items-center gap-3">
              <i class="fa-solid fa-arrow-trend-up {{ good }} text-lg"></i>
              <span class="text-sm font-bold {{ t_heading }}">{{ q }}</span>
            </div>
            {% endfor %}
          </div>
          <ul class="space-y-2 text-xs {{ t_body }}">
            {% for ql in deck.qualitative_roi %}
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-star {{ star }} mt-0.5"></i>
              <span>{{ ql }}</span>
            </li>
            {% endfor %}
          </ul>
        </div>

        <div class="anim-item glass-card rounded-2xl p-6">
          <div class="flex items-center gap-2 {{ accent_text }} font-mono-code text-xs uppercase mb-4">
            <i class="fa-solid fa-list-check"></i>
            <span>Immediate Action Items // 直近のネクストステップ</span>
          </div>
          <div class="space-y-3">
            {% for step in deck.next_steps %}
            <div class="p-3.5 rounded-xl {{ step_card }} flex items-start gap-3">
              <span class="w-6 h-6 rounded-full {{ accent_bg_soft }} {{ accent_text_light }} font-mono-code text-xs flex items-center justify-center shrink-0 mt-0.5">
                {{ loop.index }}
              </span>
              <span class="text-sm {{ t_body_soft }}">{{ step }}</span>
            </div>
            {% endfor %}
          </div>
        </div>
      </div>

      <div class="anim-item text-center text-xs {{ t_muted }} font-mono-code">
        THANK YOU FOR YOUR TIME // {{ (brand_name | default('STRATEGIC AI PARTNERS')) | upper }}
      </div>
    </section>
      </main>
    </div>
  </div>

  <!-- Bottom Navigation Bar & Progress -->
  <footer class="fixed bottom-0 left-0 right-0 z-30 px-20 py-4 {{ footer_bar }} flex items-center justify-between">
    <div class="flex items-center gap-4">
      <span id="slide-counter" class="font-mono-code text-sm font-bold {{ accent_text }}">01 / 06</span>
      <div class="w-48 h-1.5 {{ track }} rounded-full overflow-hidden">
        <div id="progress-bar" class="h-full bg-gradient-to-r {{ grad_from }} {{ grad_to }} transition-all duration-300" style="width: 16.66%;"></div>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <button id="tpl-mode-toggle" type="button" class="px-3 py-1.5 rounded-lg {{ btn_secondary }} text-xs font-mono-code transition flex items-center gap-1.5">
        <i class="fa-solid fa-table-columns"></i> <span id="tpl-mode-label">表示切替</span>
      </button>
      <button id="prev-btn" type="button" class="px-3.5 py-1.5 rounded-lg {{ btn_secondary }} text-xs font-mono-code transition flex items-center gap-1.5">
        <i class="fa-solid fa-chevron-left"></i> PREV
      </button>
      <button id="next-btn" type="button" class="px-3.5 py-1.5 rounded-lg {{ accent_bg }} {{ accent_bg_hover }} {{ btn_primary_text }} font-bold text-xs font-mono-code transition flex items-center gap-1.5">
        NEXT <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>
  </footer>

  <script>
    (function() {
      const slides = Array.from(document.querySelectorAll('.slide'));
      const totalSlides = slides.length;
      const counterEl = document.getElementById('slide-counter');
      const progressEl = document.getElementById('progress-bar');
      const prevBtn = document.getElementById('prev-btn');
      const nextBtn = document.getElementById('next-btn');
      let currentIndex = 0;

      function pad2(n) {
        return n < 10 ? '0' + n : '' + n;
      }

      function animateSlide(slideEl) {
        if (typeof gsap !== 'undefined') {
          const items = slideEl.querySelectorAll('.anim-item');
          gsap.fromTo(
            items,
            { opacity: 0, y: 24 },
            { opacity: 1, y: 0, duration: 0.55, stagger: 0.08, ease: 'power2.out' }
          );
        }
      }

      const chapterBtns = Array.from(document.querySelectorAll('.tpl-chapter-btn'));
      const modeToggleBtn = document.getElementById('tpl-mode-toggle');
      const modeLabelEl = document.getElementById('tpl-mode-label');
      const slideViewBtn = document.getElementById('tpl-slide-view-btn');

      function syncModeLabel() {
        const curFmt = document.documentElement.getAttribute('data-ui-format') || 'portal';
        if (modeLabelEl) {
          modeLabelEl.textContent = curFmt === 'portal' ? 'スライドで見る' : '記事に戻る';
        }
      }
      function setUiFormat(fmt) {
        const nextFmt = fmt === 'slides' ? 'slides' : 'portal';
        document.documentElement.setAttribute('data-ui-format', nextFmt);
        const mainEl = document.getElementById('deck-container');
        if (mainEl) mainEl.setAttribute('data-ui-format', nextFmt);
        syncModeLabel();
      }
      try {
        const q = new URLSearchParams(window.location.search).get('view');
        if (q === 'portal' || q === 'slides') setUiFormat(q);
      } catch (e) {}
      syncModeLabel();
      if (modeToggleBtn) {
        modeToggleBtn.addEventListener('click', function() {
          const curFmt = document.documentElement.getAttribute('data-ui-format') || 'portal';
          setUiFormat(curFmt === 'portal' ? 'slides' : 'portal');
        });
      }
      if (slideViewBtn) {
        slideViewBtn.addEventListener('click', function() {
          setUiFormat('slides');
        });
      }
      chapterBtns.forEach((btn) => {
        btn.addEventListener('click', function() {
          const idx = parseInt(btn.getAttribute('data-target-slide') || '0', 10);
          showSlide(idx);
        });
      });

      function showSlide(index) {
        if (index < 0 || index >= totalSlides) return;
        slides.forEach((s, idx) => {
          if (idx === index) {
            s.classList.add('active');
          } else {
            s.classList.remove('active');
          }
        });
        chapterBtns.forEach((b, idx) => {
          b.classList.toggle('is-active', idx === index);
        });
        currentIndex = index;
        counterEl.textContent = pad2(currentIndex + 1) + ' / ' + pad2(totalSlides);
        const pct = ((currentIndex + 1) / totalSlides) * 100;
        progressEl.style.width = pct.toFixed(2) + '%';
        animateSlide(slides[currentIndex]);
      }

      prevBtn.addEventListener('click', function() {
        showSlide(currentIndex - 1);
      });

      nextBtn.addEventListener('click', function() {
        showSlide(currentIndex + 1);
      });

      window.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowRight' || e.key === ' ') {
          e.preventDefault();
          showSlide(currentIndex + 1);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          showSlide(currentIndex - 1);
        }
      });

      // Restore the slide the viewer was on before an automatic "updated version" reload.
      let startIndex = 0;
      try {
        const restoreKey = 'pd-deck-slide:' + window.location.pathname;
        const saved = window.sessionStorage ? window.sessionStorage.getItem(restoreKey) : null;
        if (saved !== null) {
          window.sessionStorage.removeItem(restoreKey);
          const parsed = parseInt(saved, 10);
          if (!isNaN(parsed) && parsed >= 0 && parsed < totalSlides) {
            startIndex = parsed;
          }
        }
      } catch (err) {
        startIndex = 0;
      }
      showSlide(startIndex);
    })();
  </script>
</body>
</html>
