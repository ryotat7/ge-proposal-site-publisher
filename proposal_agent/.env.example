PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GENAI_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.8-flash
# Background generation: Cloud Run job triggered by create_proposal_website (auto -> job, then in-process thread)
GENERATION_JOB_NAME=projects/your-gcp-project-id/locations/us-central1/jobs/proposal-deck-generator
GENERATION_TRIGGER_MODE=auto
GENERATION_STALE_MINUTES=13
# Free-form design by the ADK designer agent (runs inside the Cloud Run job)
FREEFORM_DESIGN_ENABLED=true
FREEFORM_ADK_MODEL=gemini-3.8-flash
IMAGE_MODEL=gemini-3.1-flash-image
FREEFORM_TOTAL_BUDGET_SECONDS=900
FREEFORM_REVIEW_ROUNDS=2
# Private deck renderer (Cloud Run, IAM-authenticated). Leave empty to skip the screenshot review rounds.
DECK_RENDERER_URL=
PROPOSAL_GCS_BUCKET=your-gcp-project-id-proposals
PROPOSAL_FIRESTORE_COLLECTION=presentations
HOSTING_BASE_URL=https://proposal-hosting-gateway.example.run.app
# Comma- or colon-separated Agent Search DataStore IDs (e.g. "drive-rfp-ds,salesforce-crm-ds" for production 1P connectors)
AGENT_SEARCH_DATASTORE_ID=proposal-knowledge-datastore
AGENT_SEARCH_LOCATION=global
# Seeding mode for infra/seed_datastore.py: auto (default: skip existing DataStores, seed missing) | real (never seed synthetic data) | synthetic | none
SEED_MODE=auto
# Optional real data source import targets when creating a new DataStore in SEED_MODE=auto or SEED_MODE=real:
KNOWLEDGE_GCS_URI=
KNOWLEDGE_BQ_TABLE=
PROPOSAL_BRAND_NAME=Strategic AI Partners
PROPOSAL_BRAND_BADGE=SP
